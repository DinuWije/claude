# Load aliases
source "$HOME/.aliases"

# PATH helpers — idempotent so re-sourcing doesn't duplicate entries
path_prepend() { case ":$PATH:" in *":$1:"*) ;; *) PATH="$1:$PATH" ;; esac; }
path_append()  { case ":$PATH:" in *":$1:"*) ;; *) PATH="$PATH:$1" ;; esac; }

# Load homebrew shell variables (macOS, Linux, or Intel mac)
for brew_path in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$brew_path" ]; then
    eval "$("$brew_path" shellenv)"
    break
  fi
done

# Force certain more-secure behaviours from homebrew
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_CASK_OPTS=--require-sha
export HOMEBREW_DIR=/opt/homebrew
export HOMEBREW_BIN=/opt/homebrew/bin

# Load python shims (only when a real pyenv binary is installed).
# Guard on ${commands[pyenv]} — zsh's map of external executables — not
# `command -v`, which would also match the wrapper function defined below
# and re-run `pyenv init` through it (erroring) every time we re-source.
if [[ -n "${commands[pyenv]}" ]]; then
  eval "$(pyenv init -)"

  # Auto-clear stale pyenv rehash lock (left behind by interrupted pip installs)
  pyenv() {
    if [[ "$1" == "rehash" ]] && [[ -f "$PYENV_ROOT/shims/.pyenv-shim" ]]; then
      rm -f "$PYENV_ROOT/shims/.pyenv-shim"
    fi
    command pyenv "$@"
  }
fi

# Load ruby shims
command -v rbenv &>/dev/null && eval "$(rbenv init -)"

# Prefer GNU binaries to Macintosh binaries.
path_prepend "/opt/homebrew/opt/coreutils/libexec/gnubin"

# Go
export GOPATH="$HOME/go"
path_prepend "$GOPATH/bin"
export GO111MODULE=auto
export GOPRIVATE=github.com/DataDog
export GOPROXY=binaries.ddbuild.io,https://proxy.golang.org,direct
export GONOSUMDB=github.com/DataDog,go.ddbuild.io

# AWS session config
export AWS_VAULT_KEYCHAIN_NAME=login
export AWS_SESSION_TTL=24h
export AWS_ASSUME_ROLE_TTL=1h

# Helm
export HELM_DRIVER=configmap

# pipx
path_append "$HOME/.local/bin"
export PATH

# Worktree helper
source "$(dirname "$(readlink -f "${(%):-%x}")")/wt.sh"

# Workspaces helper
source "$(dirname "$(readlink -f "${(%):-%x}")")/ws.sh"

# Machine-specific overrides (not tracked in repo)
if [ -f ~/.zshrc.local ]; then
  source ~/.zshrc.local
fi

# Added by Yarn Switch ($HOME so it works regardless of macOS/Linux home path)
if [ -f "$HOME/.yarn/switch/env" ]; then
  source "$HOME/.yarn/switch/env"
fi

# Load git signing key only where dd-gitsign is installed.
# Use an `if` (not `&&`) so a missing tool doesn't make this file — and
# therefore `source ~/.zshrc` / the `src` alias — exit non-zero.
if command -v dd-gitsign &>/dev/null; then
fi

# Trajectory - AI coding agent observability
export PATH="/Users/dinu.wijetunga/.trajectory/bin:$PATH"
